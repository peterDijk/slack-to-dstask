#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_FILE="${SLACK_TO_DSTASK_CONFIG:-$ROOT/config.env}"

usage() {
  cat <<'EOF'
Usage: slack-to-dstask [options]

Finds Slack messages you reacted to with a trigger emoji and adds them to dstask.

  --dry-run              show what would be added; write nothing to dstask or seen.json
  --emoji NAME           trigger emoji without colons (default: tornado)
  --model NAME           model for the search step (default: haiku)
  --lookback-days N      how far back to search (default: 7)
  --tags "+a +b"         dstask tags for new tasks (default: +slack)
  --project NAME         dstask project for new tasks
  --max-budget-usd N     hard cost cap for the search step (default: 0.25)
  --no-sync              skip `dstask sync`
  --config FILE          config file (default: ./config.env)
  -h, --help

Every option also exists as a config/env variable, see config.example.env.
Each run appends a cost record to state/runs.jsonl, dry runs included.
EOF
}

prev=""
for a in "$@"; do
  [ "$prev" = "--config" ] && CONFIG_FILE="$a"
  prev="$a"
done
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

: "${SLACK_EMOJI:=tornado}"
: "${LOOKBACK_DAYS:=7}"
: "${MAX_PAGES:=3}"
: "${MODEL:=haiku}"
: "${MAX_BUDGET_USD:=0.25}"
: "${TITLE_MAX:=80}"
: "${DSTASK_TAGS:=+slack}"
: "${DSTASK_PROJECT:=}"
: "${DSTASK_IGNORE_CONTEXT:=0}"
: "${DSTASK_SYNC:=1}"
: "${STATE_DIR:=$ROOT/state}"
: "${DSTASK_BIN:=dstask}"
: "${CLAUDE_BIN:=claude}"
: "${ALLOWED_TOOLS:=mcp__claude_ai_Slack__slack_search_public_and_private,mcp__claude_ai_Slack__slack_get_reactions}"
: "${DISALLOWED_TOOLS:=Bash,Edit,Write,Read,WebFetch,WebSearch,Task,mcp__claude_ai_Slack__slack_send_message,mcp__claude_ai_Slack__slack_send_message_draft,mcp__claude_ai_Slack__slack_schedule_message,mcp__claude_ai_Slack__slack_add_reaction,mcp__claude_ai_Slack__slack_create_canvas,mcp__claude_ai_Slack__slack_update_canvas,mcp__claude_ai_Slack__slack_create_conversation,mcp__claude_ai_Slack__slack_create_list,mcp__claude_ai_Slack__slack_update_list,mcp__claude_ai_Slack__slack_add_list_record,mcp__claude_ai_Slack__slack_update_list_record,mcp__claude_ai_Slack__slack_get_file_upload_url,mcp__claude_ai_Slack__slack_complete_file_upload}"
DRY_RUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --emoji) SLACK_EMOJI="$2"; shift ;;
    --model) MODEL="$2"; shift ;;
    --lookback-days) LOOKBACK_DAYS="$2"; shift ;;
    --tags) DSTASK_TAGS="$2"; shift ;;
    --project) DSTASK_PROJECT="$2"; shift ;;
    --max-budget-usd) MAX_BUDGET_USD="$2"; shift ;;
    --no-sync) DSTASK_SYNC=0 ;;
    --config) shift ;;
    -h | --help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 64 ;;
  esac
  shift
done

die() { echo "error: $*" >&2; exit "${2:-1}"; }

[[ "$SLACK_EMOJI" =~ ^[a-z0-9_+-]+$ ]] || die "invalid emoji name: $SLACK_EMOJI" 64
[[ "$LOOKBACK_DAYS" =~ ^[0-9]+$ ]] || die "lookback days must be a number" 64
[[ "$MAX_PAGES" =~ ^[0-9]+$ ]] || die "max pages must be a number" 64
[[ "$TITLE_MAX" =~ ^[0-9]+$ ]] || die "title max must be a number" 64
command -v jq >/dev/null || die "jq is required"

mkdir -p "$STATE_DIR"
SEEN_FILE="$STATE_DIR/seen.json"
RUNS_FILE="$STATE_DIR/runs.jsonl"
LOCK_DIR="$STATE_DIR/lock.d"

STATUS="error"
ENVELOPE=""
FOUND=0
INVALID=0
NEW=0
ADDED=0
FAILED=0
SYNC_OK="null"
HAVE_LOCK=0
START_SECONDS=$SECONDS

log_run() {
  local env_json="{}"
  if [ -n "$ENVELOPE" ] && printf '%s' "$ENVELOPE" | jq -e 'type == "object"' >/dev/null 2>&1; then
    env_json="$ENVELOPE"
  fi
  jq -cn \
    --argjson e "$env_json" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg status "$STATUS" \
    --arg model "$MODEL" \
    --arg emoji "$SLACK_EMOJI" \
    --argjson dry "$([ "$DRY_RUN" = 1 ] && echo true || echo false)" \
    --argjson lookback "$LOOKBACK_DAYS" \
    --argjson found "$FOUND" --argjson invalid "$INVALID" --argjson new "$NEW" \
    --argjson added "$ADDED" --argjson failed "$FAILED" --argjson sync "$SYNC_OK" \
    --argjson wall "$((SECONDS - START_SECONDS))" \
    '{
      ts: $ts, status: $status, dry_run: $dry, model: $model, emoji: $emoji, lookback_days: $lookback,
      found: $found, invalid: $invalid, new: $new, added: $added, failed: $failed, sync_ok: $sync,
      wall_s: $wall, api_ms: $e.duration_api_ms, num_turns: $e.num_turns,
      cost_usd: $e.total_cost_usd,
      input_tokens: $e.usage.input_tokens, output_tokens: $e.usage.output_tokens,
      cache_read_tokens: $e.usage.cache_read_input_tokens,
      cache_creation_tokens: $e.usage.cache_creation_input_tokens,
      models: (($e.modelUsage // {}) | keys), session_id: $e.session_id
    }' >>"$RUNS_FILE"
}

release_lock() {
  if [ "$HAVE_LOCK" = 1 ]; then rm -rf "$LOCK_DIR"; fi
}

on_exit() {
  local rc=$?
  if [ "$STATUS" != "locked" ]; then log_run || echo "warning: could not write run log" >&2; fi
  release_lock
  exit $rc
}
trap on_exit EXIT

acquire_lock() {
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local pid
    pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      STATUS="locked"
      die "another run is in progress (pid $pid)" 3
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" || die "could not take lock" 3
  fi
  echo $$ >"$LOCK_DIR/pid"
  HAVE_LOCK=1
}

after_date() {
  date -v-"${LOOKBACK_DAYS}"d +%Y-%m-%d 2>/dev/null || date -d "${LOOKBACK_DAYS} days ago" +%Y-%m-%d
}

if [ "$DRY_RUN" = 0 ]; then acquire_lock; fi
[ -f "$SEEN_FILE" ] || echo '{}' >"$SEEN_FILE"

AFTER="$(after_date)"
PROMPT="$(sed -e "s/{{EMOJI}}/$SLACK_EMOJI/g" -e "s/{{AFTER}}/$AFTER/g" -e "s/{{MAX_PAGES}}/$MAX_PAGES/g" -e "s/{{TITLE_MAX}}/$TITLE_MAX/g" "$ROOT/prompt.md")"

set +e
ENVELOPE="$(printf '%s' "$PROMPT" | "$CLAUDE_BIN" -p \
  --model "$MODEL" \
  --output-format json \
  --allowedTools "$ALLOWED_TOOLS" \
  --disallowedTools "$DISALLOWED_TOOLS" \
  --no-session-persistence \
  --max-budget-usd "$MAX_BUDGET_USD" 2>"$STATE_DIR/claude.stderr")"
CLAUDE_RC=$?
set -e

if [ "$CLAUDE_RC" -ne 0 ]; then
  STATUS="claude_failed"
  die "claude exited with $CLAUDE_RC (see $STATE_DIR/claude.stderr)" 2
fi
if printf '%s' "$ENVELOPE" | jq -e '.is_error == true' >/dev/null 2>&1; then
  STATUS="claude_failed"
  die "claude reported an error: $(printf '%s' "$ENVELOPE" | jq -r '.result // "unknown"')" 2
fi

RESULT_TEXT="$(printf '%s' "$ENVELOPE" | jq -r '.result // ""')"
if ! ITEMS="$(printf '%s\n' "$RESULT_TEXT" | sed '/^```/d' | jq -c 'if type == "array" then . else error("not an array") end' 2>/dev/null)"; then
  STATUS="parse_error"
  die "search step did not return a JSON array; nothing imported" 2
fi

FOUND="$(jq 'length' <<<"$ITEMS")"
CANDIDATES="$(jq -c --argjson max "$TITLE_MAX" --arg emoji "$SLACK_EMOJI" -f "$ROOT/lib/normalize.jq" <<<"$ITEMS")"
INVALID="$((FOUND - $(jq 'length' <<<"$CANDIDATES")))"
NEW_ITEMS="$(jq -c --slurpfile seen "$SEEN_FILE" 'map(select(($seen[0][.key]) | not))' <<<"$CANDIDATES")"
NEW="$(jq 'length' <<<"$NEW_ITEMS")"

echo "found=$FOUND invalid=$INVALID new=$NEW (emoji=:$SLACK_EMOJI: since $AFTER, model=$MODEL, dry_run=$DRY_RUN)" >&2

while IFS= read -r item; do
  [ -n "$item" ] || continue
  title="$(jq -r '.title' <<<"$item")"
  notes="$(jq -r '"\(.permalink) (\(.author) in #\(.channel))" + (if (.reactions | length) > 0 then " reactions: " + (.reactions | join(", ")) else "" end)' <<<"$item")"
  key="$(jq -r '.key' <<<"$item")"

  cmd=("$DSTASK_BIN" add)
  if [ "$DSTASK_IGNORE_CONTEXT" = 1 ]; then cmd+=(--); fi
  read -r -a title_words <<<"$title"
  cmd+=("${title_words[@]}")
  if [ -n "$DSTASK_TAGS" ]; then read -r -a tag_words <<<"$DSTASK_TAGS"; cmd+=("${tag_words[@]}"); fi
  if [ -n "$DSTASK_PROJECT" ]; then cmd+=("project:$DSTASK_PROJECT"); fi
  read -r -a note_words <<<"$notes"
  cmd+=(/ "${note_words[@]}")

  if [ "$DRY_RUN" = 1 ]; then
    printf '[dry-run] would run:'; printf ' %q' "${cmd[@]}"; printf '\n'
    continue
  fi

  if "${cmd[@]}" >/dev/null; then
    ADDED=$((ADDED + 1))
    tmp="$(mktemp "$STATE_DIR/seen.XXXXXX")"
    jq --arg k "$key" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson item "$item" \
      '.[$k] = {imported_at: $ts, title: $item.title, permalink: $item.permalink, channel: $item.channel, author: $item.author}' \
      "$SEEN_FILE" >"$tmp" && mv "$tmp" "$SEEN_FILE"
  else
    FAILED=$((FAILED + 1))
    echo "warning: dstask add failed for $key" >&2
  fi
done < <(jq -c '.[]' <<<"$NEW_ITEMS")

STATUS="ok"
if [ "$FAILED" -gt 0 ]; then STATUS="partial"; fi

if [ "$DRY_RUN" = 0 ] && [ "$DSTASK_SYNC" = 1 ] && [ "$ADDED" -gt 0 ]; then
  if "$DSTASK_BIN" sync >/dev/null; then SYNC_OK="true"; else SYNC_OK="false"; fi
fi

jq -r '"cost_usd=\(.total_cost_usd // "n/a") in=\(.usage.input_tokens // "n/a") out=\(.usage.output_tokens // "n/a") cache_read=\(.usage.cache_read_input_tokens // "n/a") turns=\(.num_turns // "n/a")"' <<<"$ENVELOPE" >&2 || true

if [ "$FAILED" -gt 0 ] || [ "$SYNC_OK" = "false" ]; then exit 4; fi
