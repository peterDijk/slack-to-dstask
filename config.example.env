# Copy to config.env. Precedence: CLI flags > environment > config.env > built-in defaults.

: "${SLACK_EMOJI:=tornado}"
: "${LOOKBACK_DAYS:=7}"
: "${MAX_PAGES:=3}"

: "${MODEL:=haiku}"
: "${MAX_BUDGET_USD:=0.25}"

: "${TITLE_MAX:=80}"
: "${DSTASK_TAGS:=+slack}"
: "${DSTASK_PROJECT:=}"
: "${DSTASK_IGNORE_CONTEXT:=0}"
: "${DSTASK_SYNC:=1}"

: "${STATE_DIR:=}"
: "${DSTASK_BIN:=dstask}"
: "${CLAUDE_BIN:=claude}"
